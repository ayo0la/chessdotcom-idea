generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  chesscomUsername String    @unique
  claimed          Boolean   @default(false)
  authId           String?   @unique
  createdAt        DateTime  @default(now())
  styleProfile     Json?
  styleComputedAt  DateTime?
  blunderFingerprint    Json?
  fingerprintComputedAt DateTime?
  following        Follow[] @relation("follower")
  followers        Follow[] @relation("following")
  ratings          Rating[]
  tiltEvents       TiltEvent[]
  debriefs         Debrief[]
  debriefPrompts   DebriefPrompt[]
  ratingSnapshots  RatingSnapshot[]
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model TiltEvent {
  id         String   @id @default(cuid())
  userId     String
  lossCount  Int
  rushing    Boolean  @default(false)
  suggestion String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PendingLink {
  authId    String   @id
  username  String
  code      String
  createdAt DateTime @default(now())
}

model Debrief {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  answers   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

model DebriefPrompt {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  gameUrl   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

model RatingSnapshot {
  id          String   @id @default(cuid())
  userId      String
  timeControl String
  rating      Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timeControl, createdAt])
}

model Rating {
  id          String   @id @default(cuid())
  userId      String
  timeControl String
  rating      Int
  wins        Int
  losses      Int
  draws       Int
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, timeControl])
}
